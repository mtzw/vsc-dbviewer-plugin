{
  "name": "vsc-dbviewer-plugin",
  "displayName": "DB Viewer",
  "description": "JDBC database viewer for VS Code and compatible editors.",
  "version": "3.4.1",
  "publisher": "mtzw",
  "repository": {
    "type": "git",
    "url": "https://github.com/mtzw/vsc-dbviewer-plugin.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:dbViewer.connections",
    "onCommand:dbViewer.addConnection",
    "onCommand:dbViewer.editConnection",
    "onCommand:dbViewer.duplicateConnection",
    "onCommand:dbViewer.deleteConnection",
    "onCommand:dbViewer.refresh",
    "onCommand:dbViewer.openObject"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbViewer",
          "title": "DB Viewer",
          "icon": "resources/database.svg"
        }
      ]
    },
    "views": {
      "dbViewer": [
        {
          "id": "dbViewer.connections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "dbViewer.addConnection",
        "title": "DB Viewer: Add Connection",
        "icon": "$(add)"
      },
      {
        "command": "dbViewer.editConnection",
        "title": "DB Viewer: Edit Connection",
        "icon": "$(edit)"
      },
      {
        "command": "dbViewer.deleteConnection",
        "title": "DB Viewer: Delete Connection",
        "icon": "$(trash)"
      },
      {
        "command": "dbViewer.duplicateConnection",
        "title": "DB Viewer: Duplicate Connection",
        "icon": "$(copy)"
      },
      {
        "command": "dbViewer.refresh",
        "title": "DB Viewer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dbViewer.openObject",
        "title": "DB Viewer: Open Table or View"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbViewer.addConnection",
          "when": "view == dbViewer.connections",
          "group": "navigation"
        },
        {
          "command": "dbViewer.refresh",
          "when": "view == dbViewer.connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dbViewer.openObject",
          "when": "view == dbViewer.connections && viewItem == dbObject",
          "group": "inline"
        },
        {
          "command": "dbViewer.editConnection",
          "when": "view == dbViewer.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbViewer.refresh",
          "when": "view == dbViewer.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbViewer.refresh",
          "when": "view == dbViewer.connections && (viewItem == tables || viewItem == views)",
          "group": "inline"
        },
        {
          "command": "dbViewer.duplicateConnection",
          "when": "view == dbViewer.connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "dbViewer.deleteConnection",
          "when": "view == dbViewer.connections && viewItem == connection",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "compile": "tsc -p .",
    "build:helper": "javac --release 17 -d java-helper/build/classes java-helper/src/main/java/com/example/dbviewer/JdbcDialect.java java-helper/src/main/java/com/example/dbviewer/JdbcHelper.java",
    "build": "npm run clean && npm run compile && npm run build:helper",
    "package:vsix": "npx @vscode/vsce package --no-dependencies",
    "test:sqlserver": "node scripts/run-sqlserver-test.js",
    "test": "npm run compile && node out/test/profileStore.test.js && node out/test/jdbcClient.test.js && node out/test/databaseTypes.test.js && node out/test/copyFormat.test.js && node out/test/valueValidation.test.js && node out/test/tsvInsert.test.js && node out/test/deleteRows.test.js && node out/test/updateRows.test.js && node out/test/tableDiff.test.js && node out/test/snapshotStore.test.js && node out/test/snapshotCapture.test.js && node out/test/snapshotComparison.test.js && node out/test/diffView.test.js && node scripts/run-h2-test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.8.0"
  }
}
